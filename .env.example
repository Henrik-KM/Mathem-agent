# Copy to .env and paste your Mathem Cookie header here, or put it in cookie.txt.
# Get it from your browser while logged into Mathem: DevTools -> Network -> request to mathem.se -> Cookie request header.
MATHEM_COOKIE=""

# Mathem asks crawlers to use a meaningful UA containing "bot" and a contact/name.
MATHEM_USER_AGENT="mathem-agent-bot/0.1 personal-prototype contact:local"

# Default planner settings
MATHEM_DEFAULT_PEOPLE=2
MATHEM_DEFAULT_MEALS=4
MATHEM_DEFAULT_BUDGET_SEK=900
